# --- Required ---
OPENAI_API_KEY=sk-...

# --- Optional: model selection (default: gpt-4o-mini) ---
INTERVIEWLOOP_MODEL=gpt-4o-mini

# --- Optional: LangSmith tracing (highly recommended for the portfolio) ---
# Sign up free at https://smith.langchain.com — every run gets a trace URL you
# can share in your README, in a LinkedIn post, or send to a recruiter.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=interviewloop

# --- Optional: Gradio port (default 7860) ---
PORT=7860
